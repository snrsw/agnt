#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/snrsw/src/github.com/snrsw/agnt/.claude/worktrees/scaffold" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/snrsw/src/github.com/snrsw/agnt/.claude/worktrees/scaffold")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/snrsw/src/github.com/snrsw/agnt/.claude/worktrees/scaffold" true
